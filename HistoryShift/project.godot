; Engine configuration file.
; Godot 4.5

config_version=5

[application]

config/name="時空改変 共通テスト日本史 ―JIDAI SHIFT―"
config/description="共通テスト日本史を解き、満点にするために過去へ跳んで史実を書き換えるオープンワールドアクション"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/theme.tres"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
environment/ssil/quality=1
global_illumination/sdfgi/probe_ray_count=1
textures/default_filters/anisotropic_filtering_level=3
textures/vram_compression/import_etc2_astc=true

[editor]

export/convert_text_resources_to_binary=true

[editor_plugins]

enabled=PackedStringArray("res://addons/vrm/plugin.cfg")

[shader_globals]

toon_shade_color={
"type": "color",
"value": Color(0.55, 0.6, 0.85, 1)
}
toon_params={
"type": "vec4",
"value": Vector4(0.08, 0.06, 0.35, 0.55)
}
world_night={
"type": "float",
"value": 0.0
}
destruct_tex={
"type": "sampler2D",
"value": ""
}
world_sky_color={
"type": "color",
"value": Color(0.6, 0.78, 0.96, 1)
}
world_sun_color={
"type": "color",
"value": Color(1, 0.94, 0.84, 1)
}
world_wind={
"type": "vec4",
"value": Vector4(0.8, 0.6, 1, 0)
}
world_indoor={
"type": "float",
"value": 0.0
}
